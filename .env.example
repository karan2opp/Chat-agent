# Required: the only API key. Used by the agent, its hosted web search tool, the background
# memory jobs and embeddings.
OPENAI_API_KEY=

# Model the agent runs on
OPENAI_MODEL=gpt-5.6-luna

# Matches docker-compose.yml
DATABASE_URL=postgres://minimi:minimi@localhost:54329/minimi

# API server port (the Vite dev server proxies /api to it)
PORT=3001

# ---- Optional (defaults shown) ----

# Model for background memory jobs (claim extraction, summaries). Defaults to OPENAI_MODEL;
# point it at a cheaper model if you like.
# OPENAI_BACKGROUND_MODEL=gpt-5.6-luna

# Embedding model (must produce 1536-dimension vectors to match the turn_embeddings table)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Prompt budgets in estimated tokens. They are caps, not targets.
# MEMORY_CORE_TOKENS=3000       facts about the user, always in the prompt
# MEMORY_PERSONA_TOKENS=1500    Ray's own backstory, always in the prompt
# MEMORY_SUMMARY_TOKENS=4000    summary of turns that left the recent window
# MEMORY_RECENT_TOKENS=40000    recent turns of the chat, word for word
