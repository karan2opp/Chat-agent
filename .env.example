# Required: OpenAI API key (used by the agent and its hosted web search tool)
OPENAI_API_KEY=

# Model the agent runs on
OPENAI_MODEL=gpt-5.6-luna

# Matches docker-compose.yml
DATABASE_URL=postgres://minimi:minimi@localhost:5432/minimi

# API server port (the Vite dev server proxies /api to it)
PORT=3001
